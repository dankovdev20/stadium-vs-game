{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd client && npm run dev"],
      "port": 5173
    },
    {
      "name": "client-dev-2",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd client && npm run dev -- --port 5174 --strictPort"],
      "port": 5174
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd server && npm start"],
      "port": 3000
    },
    {
      "name": "stand-3100",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd server && PORT=3100 npm start"],
      "port": 3100
    }
  ]
}
